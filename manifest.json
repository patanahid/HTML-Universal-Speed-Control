{
  "manifest_version": 2,
  "name": "HTML Universal Speed Controller",
  "version": "3.2",
  "description": "Control the speed of HTML websites with various timing methods",
  "browser_specific_settings": {
    "gecko": {
      "id": "speed-controller@example.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["shared/settings.js", "background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page/page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["shared/settings.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    "page/page.js"
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "Speed Controller",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "browser_style": true,
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  }
}
